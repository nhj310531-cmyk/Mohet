local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TargetSpeed = 80 -- تم رفع السرعة لضمان الملاحظة الفورية
local SpeedEnabled = false

local UserKey = _G.Key or "USER_KEY_HERE"

local KeyDatabase = {
    ["VIP-USER-9921"] = {year = 2026, month = 10, day = 15},
    ["TRIAL-KEY-55"]  = {year = 2026, month = 10, day = 9},
    ["G-H45V-DUP3-GW8H-3JLR"] = {year = 2026, month = 10, day = 30}
}

if KeyDatabase[UserKey] then
    local ExpiryDate = KeyDatabase[UserKey]
    local CurrentTimeTable = os.date("!*t")
    local CurrentTimestamp = os.time(CurrentTimeTable)
    local ExpiryTimestamp = os.time({year = ExpiryDate.year, month = ExpiryDate.month, day = ExpiryDate.day, hour = 23, min = 59, sec = 59})
    
    if CurrentTimestamp <= ExpiryTimestamp then
        print("[نظام المفاتيح]: تم التحقق بنجاح!")
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "تم التحقق بنجاح!";
            Text = "مرحباً بك، تم تفعيل سكريبت Brookhaven المتكامل!";
            Duration = 5;
        })
        SpeedEnabled = true
    else
        LocalPlayer:Kick("[نظام المفاتيح]: عذراً، هذا المفتاح انتهت مدة صلاحيته!")
        return
    end
else
    LocalPlayer:Kick("[نظام الحماية الكامل]: مفتاح خاطئ أو غير موجود!")
    return
end

-- تعديل طريقة الدفع والفيزياء لتجبر اللعبة على التحرك السريع فوراً
RunService.Stepped:Connect(function()
    if SpeedEnabled and LocalPlayer.Character then
        local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        
        if rootPart and humanoid and humanoid.MoveDirection.Magnitude > 0 then
            -- تغيير سرعة المحرك الداخلي مباشرة ليتخطى حماية الماب
            rootPart.Velocity = rootPart.Velocity:Lerp(humanoid.MoveDirection * TargetSpeed, 0.5)
        end
    end
end)

print("[نظام Brookhaven الجديد]: تم تثبيت السرعة الفيزيائية القوية.")
